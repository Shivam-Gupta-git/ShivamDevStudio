# Server port
PORT=3001

# Judge0 — choose ONE option below
# Option A: Self-hosted Judge0 (recommended for local dev)
#   docker run -d -p 2358:2358 judge0/judge0:1.13.0
JUDGE0_BASE_URL=http://localhost:2358

# Option B: RapidAPI Judge0 CE (cloud)
# JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_RAPIDAPI_KEY=your_rapidapi_key_here
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# LLM for code explanation & efficiency analysis (OpenAI-compatible API)
# Works with OpenAI, Anthropic via proxy, or local Ollama
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
